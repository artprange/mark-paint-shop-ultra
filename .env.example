# =============================================================================
# Front-end (prefixo VITE_ — tudo aqui vai para o bundle e é público)
# =============================================================================

# Base URL da API de produtos.
# Comentado: a aplicação usa o catálogo local de src/services/products/mock.ts
# e sobe sem backend e sem nenhuma chave.
# Preenchido: o serviço monta <raiz>/products e <raiz>/single-product?id=.
# VITE_PRODUCTS_API=/.netlify/functions

# Auth0. Faltando qualquer uma, a aplicação usa o login simulado.
# VITE_AUTH0_DOMAIN=
# VITE_AUTH0_CLIENT_ID=

# Stripe. Faltando qualquer uma, o checkout é simulado e não cobra nada.
# A chave PÚBLICA é a única que pode ficar aqui.
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
# VITE_PAYMENTS_API=/.netlify/functions

# =============================================================================
# Back-end (Netlify Functions — sem prefixo VITE_, nunca chega ao navegador)
# =============================================================================

# AIRTABLE_API_KEY=
# AIRTABLE_BASE=
# AIRTABLE_TABLE=

# Chave SECRETA da Stripe. Nunca use o prefixo VITE_ aqui: isso a publicaria
# no bundle do navegador.
# STRIPE_SECRET_KEY=sk_test_...
