# Base URL da API de produtos.
#
# Deixe comentado para rodar com o catálogo local (src/services/products/mock.ts):
# a aplicação sobe sem backend e sem nenhuma chave.
#
# Preencha para falar com a API de verdade. O valor é a raiz — o serviço monta
# `<raiz>/products` e `<raiz>/single-product?id=` em cima dele.
#
# VITE_PRODUCTS_API=/.netlify/functions
# VITE_PRODUCTS_API=https://sua-api.exemplo.com
